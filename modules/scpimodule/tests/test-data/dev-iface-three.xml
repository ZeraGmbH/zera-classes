<!DOCTYPE SCPIModel>
<MODELLIST>
 <DEVICE>DEMO</DEVICE>
 <RELEASE></RELEASE>
 <MODELS>
  <INIT ScpiPath="INIT" Type="Model,Node,Command">
   <RNG1 ScpiPath="INIT:RNG1" Type="Node,Command">
    <UL1 Unit="V" Description="Actual peak value" ScpiPath="INIT:RNG1:UL1" Type="Command"/>
    <IL2 Unit="A" Description="Actual peak value" ScpiPath="INIT:RNG1:IL2" Type="Command"/>
    <IAUX Unit="A" Description="Actual peak value" ScpiPath="INIT:RNG1:IAUX" Type="Command"/>
    <UL2 Unit="V" Description="Actual peak value" ScpiPath="INIT:RNG1:UL2" Type="Command"/>
    <UL3 Unit="V" Description="Actual peak value" ScpiPath="INIT:RNG1:UL3" Type="Command"/>
    <IL3 Unit="A" Description="Actual peak value" ScpiPath="INIT:RNG1:IL3" Type="Command"/>
    <UAUX Unit="V" Description="Actual peak value" ScpiPath="INIT:RNG1:UAUX" Type="Command"/>
    <F Unit="Hz" Description="Actual frequency" ScpiPath="INIT:RNG1:F" Type="Command"/>
    <IL1 Unit="A" Description="Actual peak value" ScpiPath="INIT:RNG1:IL1" Type="Command"/>
   </RNG1>
  </INIT>
  <SYSTEM Type="Model,Node">
   <ERROR Description="Queries first error from error queue and removes it from queue" ScpiPath="SYSTEM:ERROR" Type="Node,Query">
    <COUNT Description="Queries the number of error messages of internal error list" ScpiPath="SYSTEM:ERROR:COUNT" Type="Query"/>
    <ALL Description="Queries all errors from error queue and removes them from queue" ScpiPath="SYSTEM:ERROR:ALL" Type="Query"/>
   </ERROR>
  </SYSTEM>
  <MULSRE Description="Service Request Enable" ScpiPath="*SRE" Type="Model,Query,Command+Par"/>
  <CONFIGURATION Type="Model,Node">
   <SYST Type="Node">
    <XSESSION DataType="STRING" Description="XSession name" ScpiPath="CONFIGURATION:SYST:XSESSION" Type="Query,Command+Par" ValidPar="Foo,Bar">
     <CATALOG ScpiPath="CONFIGURATION:SYST:XSESSION:CATALOG" Type="Query"/>
    </XSESSION>
    <SESSION Type="Node">
     <CATALOG ScpiPath="CONFIGURATION:SYST:SESSION:CATALOG" Type="Query"/>
    </SESSION>
    <NAMESESSION DataType="STRING" Description="Session name" ScpiPath="CONFIGURATION:SYST:NAMESESSION" Type="Query,Command+Par" ValidPar="Default,EMOB AC,EMOB DC,DC: 4*Voltage / 1*Current"/>
   </SYST>
   <RNG1 Type="Node">
    <ENABLEIGNORERMSVAL Min="0" DataType="BOOL" Description="Enable or disable channel ignore limit option" ScpiPath="CONFIGURATION:RNG1:ENABLEIGNORERMSVAL" Max="1" Type="Query,Command+Par"/>
    <UL1 Type="Node">
     <INVERTPHASE Min="0" DataType="BOOL" Description="Inverted Phase" ScpiPath="CONFIGURATION:RNG1:UL1:INVERTPHASE" Max="1" Type="Query,Command+Par"/>
    </UL1>
    <RNGTIMER Min="0" DataType="INTEGER" Description="Range timer for range decrease" ScpiPath="CONFIGURATION:RNG1:RNGTIMER" Max="600000" Type="Query,Command+Par"/>
    <IL2 Type="Node">
     <INVERTPHASE Min="0" DataType="BOOL" Description="Inverted Phase" ScpiPath="CONFIGURATION:RNG1:IL2:INVERTPHASE" Max="1" Type="Query,Command+Par"/>
    </IL2>
    <GROUPING Min="0" DataType="BOOL" Description="Channel grouping on/off" ScpiPath="CONFIGURATION:RNG1:GROUPING" Max="1" Type="Query,Command+Par"/>
    <IAUX Type="Node">
     <INVERTPHASE Min="0" DataType="BOOL" Description="Inverted Phase" ScpiPath="CONFIGURATION:RNG1:IAUX:INVERTPHASE" Max="1" Type="Query,Command+Par"/>
    </IAUX>
    <UL2 Type="Node">
     <INVERTPHASE Min="0" DataType="BOOL" Description="Inverted Phase" ScpiPath="CONFIGURATION:RNG1:UL2:INVERTPHASE" Max="1" Type="Query,Command+Par"/>
    </UL2>
    <UL3 Type="Node">
     <INVERTPHASE Min="0" DataType="BOOL" Description="Inverted Phase" ScpiPath="CONFIGURATION:RNG1:UL3:INVERTPHASE" Max="1" Type="Query,Command+Par"/>
    </UL3>
    <IL3 Type="Node">
     <INVERTPHASE Min="0" DataType="BOOL" Description="Inverted Phase" ScpiPath="CONFIGURATION:RNG1:IL3:INVERTPHASE" Max="1" Type="Query,Command+Par"/>
    </IL3>
    <UAUX Type="Node">
     <INVERTPHASE Min="0" DataType="BOOL" Description="Inverted Phase" ScpiPath="CONFIGURATION:RNG1:UAUX:INVERTPHASE" Max="1" Type="Query,Command+Par"/>
    </UAUX>
    <IGNORERMSVAL Unit="%" Min="0" DataType="DOUBLE" Description="Percentage of nominal range below which channel values are ignored" ScpiPath="CONFIGURATION:RNG1:IGNORERMSVAL" Max="2" Type="Query,Command+Par"/>
    <IL1 Type="Node">
     <INVERTPHASE Min="0" DataType="BOOL" Description="Inverted Phase" ScpiPath="CONFIGURATION:RNG1:IL1:INVERTPHASE" Max="1" Type="Query,Command+Par"/>
    </IL1>
    <RNGAUTO Min="0" DataType="BOOL" Description="Range automatic on/off" ScpiPath="CONFIGURATION:RNG1:RNGAUTO" Max="1" Type="Query,Command+Par"/>
   </RNG1>
  </CONFIGURATION>
  <SENSE Type="Model,Node">
   <RNG1 Type="Node">
    <UL1 Type="Node">
     <RANGE DataType="STRING" Description="Channel's range" ScpiPath="SENSE:RNG1:UL1:RANGE" Type="Query,Command+Par" ValidPar="250V,8V,100mV">
      <CATALOG ScpiPath="SENSE:RNG1:UL1:RANGE:CATALOG" Type="Query"/>
     </RANGE>
    </UL1>
    <IL2 Type="Node">
     <RANGE DataType="STRING" Description="Channel's range" ScpiPath="SENSE:RNG1:IL2:RANGE" Type="Query,Command+Par" ValidPar="10A,5A,2.5A,1.0A,500mA,250mA,100mA,50mA,25mA">
      <CATALOG ScpiPath="SENSE:RNG1:IL2:RANGE:CATALOG" Type="Query"/>
     </RANGE>
    </IL2>
    <IAUX Type="Node">
     <RANGE DataType="STRING" Description="Channel's range" ScpiPath="SENSE:RNG1:IAUX:RANGE" Type="Query,Command+Par" ValidPar="--">
