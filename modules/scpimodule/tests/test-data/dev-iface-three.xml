      <CATALOG ScpiPath="SENSE:RNG1:UL2:RANGE:CATALOG" Type="Query"/>
     </RANGE>
    </UL2>
    <UL3 Type="Node">
     <RANGE DataType="STRING" Description="Channel's range" ScpiPath="SENSE:RNG1:UL3:RANGE" Type="Query,Command+Par" ValidPar="250V,8V,100mV">
      <CATALOG ScpiPath="SENSE:RNG1:UL3:RANGE:CATALOG" Type="Query"/>
     </RANGE>
    </UL3>
    <IL3 Type="Node">
     <RANGE DataType="STRING" Description="Channel's range" ScpiPath="SENSE:RNG1:IL3:RANGE" Type="Query,Command+Par" ValidPar="10A,5A,2.5A,1.0A,500mA,250mA,100mA,50mA,25mA">
      <CATALOG ScpiPath="SENSE:RNG1:IL3:RANGE:CATALOG" Type="Query"/>
     </RANGE>
    </IL3>
    <UAUX Type="Node">
     <RANGE DataType="STRING" Description="Channel's range" ScpiPath="SENSE:RNG1:UAUX:RANGE" Type="Query,Command+Par" ValidPar="250V,8V,100mV">
      <CATALOG ScpiPath="SENSE:RNG1:UAUX:RANGE:CATALOG" Type="Query"/>
     </RANGE>
    </UAUX>
    <IL1 Type="Node">
     <RANGE DataType="STRING" Description="Channel's range" ScpiPath="SENSE:RNG1:IL1:RANGE" Type="Query,Command+Par" ValidPar="10A,5A,2.5A,1.0A,500mA,250mA,100mA,50mA,25mA">
      <CATALOG ScpiPath="SENSE:RNG1:IL1:RANGE:CATALOG" Type="Query"/>
     </RANGE>
    </IL1>
    <OVERLOAD Min="0" DataType="BOOL" Description="Overload" ScpiPath="SENSE:RNG1:OVERLOAD" Max="1" Type="Query,Command+Par"/>
   </RNG1>
  </SENSE>
