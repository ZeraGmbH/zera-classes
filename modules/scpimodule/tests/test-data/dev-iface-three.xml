  <STATUS Type="Model,Node">
   <DEV1 Type="Node">
    <SERIAL RegEx="^\d{9}$" DataType="STRING" Description="Serial number" ScpiPath="STATUS:DEV1:SERIAL" Type="Query,Command+Par"/>
    <CPUINFO Description="CPU/SOM info" ScpiPath="STATUS:DEV1:CPUINFO" Type="Query"/>
    <VERSION Type="Node">
     <DSPSERVER Description="DSP-server version" ScpiPath="STATUS:DEV1:VERSION:DSPSERVER" Type="Query"/>
     <FPGA Description="FPGA version" ScpiPath="STATUS:DEV1:VERSION:FPGA" Type="Query"/>
     <PCB Description="PCB version" ScpiPath="STATUS:DEV1:VERSION:PCB" Type="Query"/>
     <DSP Description="DSP software version" ScpiPath="STATUS:DEV1:VERSION:DSP" Type="Query"/>
     <CONTROLER Description="Controller version" ScpiPath="STATUS:DEV1:VERSION:CONTROLER" Type="Query"/>
     <PCBSERVER Description="PCB-server version" ScpiPath="STATUS:DEV1:VERSION:PCBSERVER" Type="Query"/>
    </VERSION>
    <DEVTYPE Description="Device type e.g 'mt310s2' or 'com5003'" ScpiPath="STATUS:DEV1:DEVTYPE" Type="Query"/>
    <RELEASE Description="Release number" ScpiPath="STATUS:DEV1:RELEASE" Type="Query"/>
    <DSP Type="Node">
     <BUSYPERCENT Unit="%" Description="DSP Busy value [%]" ScpiPath="STATUS:DEV1:DSP:BUSYPERCENT" Type="Query"/>
     <TIMEMS Description="DSP ms timer" ScpiPath="STATUS:DEV1:DSP:TIMEMS" Type="Query"/>
     <PERIODCOUNT Description="DSP period count" ScpiPath="STATUS:DEV1:DSP:PERIODCOUNT" Type="Query"/>
    </DSP>
    <ADJCHKSUM Description="Adjustment data checksum device" ScpiPath="STATUS:DEV1:ADJCHKSUM" Type="Query"/>
