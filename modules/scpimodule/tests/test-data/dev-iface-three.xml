    <UL1 Unit="V" Description="Actual peak value" ScpiPath="CONFIGURE:RNG1:UL1" Type="Command"/>
    <IL2 Unit="A" Description="Actual peak value" ScpiPath="CONFIGURE:RNG1:IL2" Type="Command"/>
