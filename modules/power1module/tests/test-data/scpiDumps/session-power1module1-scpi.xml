<!DOCTYPE SCPIModel>
<MODELLIST>
  <DEVICE>DEMO</DEVICE>
  <MODELS>
    <CONFIGURATION Type="Model,Node">
      <POW1 Type="Node">
        <M0CONSTANT Description="Frequency output constant" ScpiPath="CONFIGURATION:POW1:M0CONSTANT" Type="Query"/>
        <M0OUT Description="Frequency output name" ScpiPath="CONFIGURATION:POW1:M0OUT" Type="Query"/>
        <MEASMODEPHASESELECT DataType="STRING" Description="Active phases selection mask" ScpiPath="CONFIGURATION:POW1:MEASMODEPHASESELECT" Type="Query,Command+Par" ValidPar="000,100,010,110,001,101,011,111"/>
        <MMODE DataType="STRING" Description="Measuring mode" ScpiPath="CONFIGURATION:POW1:MMODE" Type="Query,Command+Par" ValidPar="4LW,3LW,2LW">
          <CATALOG ScpiPath="CONFIGURATION:POW1:MMODE:CATALOG" Type="Query"/>
        </MMODE>
        <TINTEGRATION DataType="DOUBLE" Description="Integration time" Max="100" Min="1" ScpiPath="CONFIGURATION:POW1:TINTEGRATION" Type="Query,Command+Par" Unit="s"/>
      </POW1>
      <SYST Type="Node">
        <NAMESESSION DataType="STRING" Description="Session name" ScpiPath="CONFIGURATION:SYST:NAMESESSION" Type="Query,Command+Par" ValidPar="Default,EMOB AC,EMOB DC,DC: 4*Voltage / 1*Current"/>
        <SESSION Type="Node">
          <CATALOG ScpiPath="CONFIGURATION:SYST:SESSION:CATALOG" Type="Query"/>
        </SESSION>
        <XSESSION DataType="STRING" Description="XSession name" ScpiPath="CONFIGURATION:SYST:XSESSION" Type="Query,Command+Par" ValidPar="Foo,Bar">
          <CATALOG ScpiPath="CONFIGURATION:SYST:XSESSION:CATALOG" Type="Query"/>
        </XSESSION>
      </SYST>
    </CONFIGURATION>
    <CONFIGURE ScpiPath="CONFIGURE" Type="Model,Node,Command">
      <POW1 ScpiPath="CONFIGURE:POW1" Type="Node,Command">
        <P1 Description="Actual power value UL1/IL1" ScpiPath="CONFIGURE:POW1:P1" Type="Command" Unit="W"/>
        <P2 Description="Actual power value UL2/IL2" ScpiPath="CONFIGURE:POW1:P2" Type="Command" Unit="W"/>
        <P3 Description="Actual power value UL3/IL3" ScpiPath="CONFIGURE:POW1:P3" Type="Command" Unit="W"/>
        <PS Description="Actual power value sum all phases" ScpiPath="CONFIGURE:POW1:PS" Type="Command" Unit="W"/>
      </POW1>
    </CONFIGURE>
    <DEVICE Type="Model,Node">
      <IFACE ScpiPath="DEVICE:IFACE" Type="Query"/>
    </DEVICE>
    <FETCH ScpiPath="FETCH" Type="Model,Node,Query">
      <POW1 ScpiPath="FETCH:POW1" Type="Node,Query">
        <P1 Description="Actual power value UL1/IL1" ScpiPath="FETCH:POW1:P1" Type="Query" Unit="W"/>
        <P2 Description="Actual power value UL2/IL2" ScpiPath="FETCH:POW1:P2" Type="Query" Unit="W"/>
        <P3 Description="Actual power value UL3/IL3" ScpiPath="FETCH:POW1:P3" Type="Query" Unit="W"/>
        <PS Description="Actual power value sum all phases" ScpiPath="FETCH:POW1:PS" Type="Query" Unit="W"/>
      </POW1>
    </FETCH>
    <INIT ScpiPath="INIT" Type="Model,Node,Command">
      <POW1 ScpiPath="INIT:POW1" Type="Node,Command">
        <P1 Description="Actual power value UL1/IL1" ScpiPath="INIT:POW1:P1" Type="Command" Unit="W"/>
        <P2 Description="Actual power value UL2/IL2" ScpiPath="INIT:POW1:P2" Type="Command" Unit="W"/>
        <P3 Description="Actual power value UL3/IL3" ScpiPath="INIT:POW1:P3" Type="Command" Unit="W"/>
        <PS Description="Actual power value sum all phases" ScpiPath="INIT:POW1:PS" Type="Command" Unit="W"/>
      </POW1>
    </INIT>
    <MEASURE ScpiPath="MEASURE" Type="Model,Node,Query">
      <POW1 ScpiPath="MEASURE:POW1" Type="Node,Query">
        <P1 Description="Actual power value UL1/IL1" ScpiPath="MEASURE:POW1:P1" Type="Query" Unit="W"/>
        <P2 Description="Actual power value UL2/IL2" ScpiPath="MEASURE:POW1:P2" Type="Query" Unit="W"/>
        <P3 Description="Actual power value UL3/IL3" ScpiPath="MEASURE:POW1:P3" Type="Query" Unit="W"/>
        <PS Description="Actual power value sum all phases" ScpiPath="MEASURE:POW1:PS" Type="Query" Unit="W"/>
      </POW1>
    </MEASURE>
    <MULCLS Description="Clear Status" ScpiPath="*CLS" Type="Model,Command"/>
    <MULESE Description="Event Status Enable" ScpiPath="*ESE" Type="Model,Query,Command+Par"/>
    <MULESR Description="Event Status Register" ScpiPath="*ESR" Type="Model,Query"/>
    <MULIDN Description="Identification query" ScpiPath="*IDN" Type="Model,Query"/>
    <MULOPC Description="OPeration Complete" ScpiPath="*OPC" Type="Model,Query,Command"/>
    <MULRST Description="Reset" ScpiPath="*RST" Type="Model,Command"/>
    <MULSRE Description="Service Request Enable" ScpiPath="*SRE" Type="Model,Query,Command+Par"/>
    <MULSTB Description="Status Byte query:&#10;Bit0: Unused - always 0&#10;Bit1: Unused - always 0&#10;Bit2: Error queue not empty - read further details by SYSTEM:ERROR queries&#10;Bit3: Questionable (=non fatal errors / warnings) available&#10;Bit4: Message available - Unused - always 0&#10;Bit5: Event summary - set if enabled events in ESE are set in ESR&#10;Bit6: Requested service (or MSS Master summary status)&#10;Bit7: Operation status summary&#10;" ScpiPath="*STB" Type="Model,Query"/>
    <MULTST Description="Self-Test query" ScpiPath="*TST" Type="Model,Query"/>
    <READ ScpiPath="READ" Type="Model,Node,Query">
      <POW1 ScpiPath="READ:POW1" Type="Node,Query">
        <P1 Description="Actual power value UL1/IL1" ScpiPath="READ:POW1:P1" Type="Query" Unit="W"/>
        <P2 Description="Actual power value UL2/IL2" ScpiPath="READ:POW1:P2" Type="Query" Unit="W"/>
        <P3 Description="Actual power value UL3/IL3" ScpiPath="READ:POW1:P3" Type="Query" Unit="W"/>
        <PS Description="Actual power value sum all phases" ScpiPath="READ:POW1:PS" Type="Query" Unit="W"/>
      </POW1>
    </READ>
    <STATUS Type="Model,Node">
      <OPERATION Type="Node">
        <CONDITION ScpiPath="STATUS:OPERATION:CONDITION" Type="Query"/>
        <ENABLE ScpiPath="STATUS:OPERATION:ENABLE" Type="Query,Command+Par"/>
        <EVENT ScpiPath="STATUS:OPERATION:EVENT" Type="Query"/>
        <MEASURE Type="Node">
          <CONDITION ScpiPath="STATUS:OPERATION:MEASURE:CONDITION" Type="Query"/>
          <ENABLE ScpiPath="STATUS:OPERATION:MEASURE:ENABLE" Type="Query,Command+Par"/>
          <EVENT ScpiPath="STATUS:OPERATION:MEASURE:EVENT" Type="Query"/>
          <NTRANSITION ScpiPath="STATUS:OPERATION:MEASURE:NTRANSITION" Type="Query,Command+Par"/>
          <PTRANSITION ScpiPath="STATUS:OPERATION:MEASURE:PTRANSITION" Type="Query,Command+Par"/>
        </MEASURE>
        <NTRANSITION ScpiPath="STATUS:OPERATION:NTRANSITION" Type="Query,Command+Par"/>
        <PTRANSITION ScpiPath="STATUS:OPERATION:PTRANSITION" Type="Query,Command+Par"/>
      </OPERATION>
      <QUESTIONABLE Type="Node">
        <CONDITION ScpiPath="STATUS:QUESTIONABLE:CONDITION" Type="Query"/>
        <ENABLE ScpiPath="STATUS:QUESTIONABLE:ENABLE" Type="Query,Command+Par"/>
        <EVENT ScpiPath="STATUS:QUESTIONABLE:EVENT" Type="Query"/>
        <NTRANSITION ScpiPath="STATUS:QUESTIONABLE:NTRANSITION" Type="Query,Command+Par"/>
        <PTRANSITION ScpiPath="STATUS:QUESTIONABLE:PTRANSITION" Type="Query,Command+Par"/>
      </QUESTIONABLE>
    </STATUS>
    <SYSTEM Type="Model,Node">
      <ERROR Description="Queries first error from error queue and removes it from queue" ScpiPath="SYSTEM:ERROR" Type="Node,Query">
        <ALL Description="Queries all errors from error queue and removes them from queue" ScpiPath="SYSTEM:ERROR:ALL" Type="Query"/>
        <COUNT Description="Queries the number of error messages of internal error list" ScpiPath="SYSTEM:ERROR:COUNT" Type="Query"/>
      </ERROR>
    </SYSTEM>
  </MODELS>
  <RELEASE/>
</MODELLIST>
